# === Vercel Environment Variables for RewardNexus Web ===
# Copy these to your Vercel dashboard: Settings > Environment Variables

# Monetag
NEXT_PUBLIC_MONETAG_SDK_ZONE=11443377
NEXT_PUBLIC_MONETAG_SMART_LINK=https://omg10.com/4/11368455

# Telegram Bot
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/xpe_official_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=xpe_official_bot

# CPA Offer Walls (register at each platform and add your IDs)
NEXT_PUBLIC_CPALEAD_APP_ID=your_cpalead_app_id
NEXT_PUBLIC_ADGATE_MEDIA_ID=your_adgate_media_id
NEXT_PUBLIC_TOROX_APP_ID=your_torox_app_id
NEXT_PUBLIC_AYETSTUDIOS_APP_ID=your_ayetstudios_app_id

# Crypto Affiliates
NEXT_PUBLIC_BINANCE_REF_LINK=https://www.binance.com/register?ref=YOUR_REF_CODE
NEXT_PUBLIC_BYBIT_REF_LINK=https://www.bybit.com/register?ref=YOUR_REF_CODE
NEXT_PUBLIC_KUCOIN_REF_LINK=https://www.kucoin.com/register?ref=YOUR_REF_CODE

# PayPal (for user withdrawals)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
NEXT_PUBLIC_PAYPAL_ME_LINK=https://paypal.me/yourpaypal

# App Download
NEXT_PUBLIC_APK_DOWNLOAD_URL=https://github.com/xpeee-banned/BOT-FATHER/releases/download/latest/app-debug.apk

# API endpoints (for future backend)
NEXT_PUBLIC_API_URL=https://your-api-url.com

# === Android BuildConfig Fields (used by Secrets Gradle Plugin) ===
# These generate BuildConfig.GEMINI_API_KEY and BuildConfig.TELEGRAM_BOT_TOKEN
GEMINI_API_KEY=placeholder_for_ci_build
TELEGRAM_BOT_TOKEN=placeholder_for_ci_build
